version: '3.9'

services:
  app:
    build: .
    ports:
      - "{{port}}:{{port}}"
    environment:
      - MONGO_URI=mongodb://mongo:27017/{{database_name}}
    depends_on:
      - mongo

  mongo:
    image: mongo:6-jammy
    ports:
      - "27017:27017"
    volumes:
      - mongo_data:/data/db

volumes:
  mongo_data:
